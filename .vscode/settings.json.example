// Copy to .vscode/settings.json. Formatting matches `make lint`: Oxc (Oxfmt + Oxlint, config in
// frontend/vite.config.ts) for TS/JS/Vue/JSON, Ruff for Python, ESLint only for Vue templates.
{
  // Frontend: Oxc formats and fixes; Oxfmt has no range formatting.
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[vue]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "oxc.fmt.configPath": "frontend/vite.config.ts",
  "oxc.disableNestedConfig": true,
  "oxc.fmt.disableNestedConfig": true,
  "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" },

  // ESLint only lints <template> blocks of .vue files (Oxlint covers scripts); it never formats.
  "eslint.validate": ["vue"],
  "eslint.workingDirectories": ["frontend"],
  "eslint.format.enable": false,

  // Backend: Ruff formats, sorts imports and fixes; ty is the language server.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.configuration": "backend/pyproject.toml",
  "ty.configurationFile": "backend/ty.toml",
  "python.defaultInterpreterPath": "backend/.venv/bin/python",
  "python.languageServer": "None",
  "python.testing.pytestEnabled": true,
  "python.testing.cwd": "${workspaceFolder}/backend",
  "python.testing.pytestArgs": ["app", "-s", "--keepdb"],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,

  "npm.packageManager": "pnpm"
}
