#!/bin/sh
# Shared finish script for every longrun: service-finish <name> <exit code> <signal>.
# s6 passes exit code 256 when the process was killed by a signal.
# Every service is critical: if it exits while it is still wanted up, record its exit code
# as the container's exit code and halt, so Docker's restart policy (or the orchestrator)
# starts a clean container instead of s6 restarting one process in a half-broken one.
name="$1"
code="$2"
signal="$3"

# A deliberate stop (container shutdown, s6-rc -d) is not a crash.
if [ "$(/command/s6-svstat -o wantedup .)" = "false" ]; then
    exit 0
fi

if [ "$code" -eq 256 ]; then
    code=$((128 + signal))
elif [ "$code" -eq 0 ]; then
    # A long-running service must not exit, even cleanly.
    code=1
fi

echo "service-finish: ${name} exited unexpectedly (exit=$2 signal=$3); stopping the container with code ${code}" >&2
echo "$code" > /run/s6-linux-init-container-results/exitcode
exec /run/s6/basedir/bin/halt
