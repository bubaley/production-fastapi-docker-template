{
  "name": "fastapi-nuxt-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --dotenv ../.env",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings && eslint \"**/*.vue\" --max-warnings 0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "vp lint --fix && eslint \"**/*.vue\" --fix --cache --cache-location node_modules/.cache/eslint/",
    "test": "vp test run",
    "check:unused": "knip --include files,dependencies,devDependencies,unlisted,unresolved,binaries",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run check:architecture"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.41.0",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-virtual": "^3.12.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "dayjs-nuxt": "^2.1.11",
    "lodash-es": "^4.18.1",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "sass": "^1.102.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "v-viewer": "^3.0.23",
    "viewerjs": "^1.11.8",
    "vue": "^3.5.41",
    "vue-color": "^3.3.3",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.1",
    "eslint-plugin-oxlint": "^1.89.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.0.0",
    "knip": "^6.42.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.1",
    "vite-plus": "1.3.0",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "packageManager": "pnpm@10.33.0"
}
