# Caddy inside the app image: the only listener exposed by the container (:8080).
# TLS terminates upstream (load balancer / host proxy), so this site speaks plain HTTP.
{
	admin off
	persist_config off
	auto_https off
	grace_period 20s

	servers {
		# Trust X-Forwarded-* only from private networks (the upstream proxy / Docker network).
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}

	log {
		output stdout
		format json
	}
}

:8080 {
	log {
		output stdout
		format json
	}
	log_skip /healthz

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		?Content-Security-Policy "frame-ancestors 'none'"
		-Server
		-Via
		-X-Powered-By
	}

	# Liveness of the proxy itself; the image HEALTHCHECK also probes the services behind it.
	handle /healthz {
		respond "ok" 200
	}

	handle /api/v1/* {
		request_body {
			max_size {$API_MAX_BODY_SIZE:25MB}
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle /ws/* {
		reverse_proxy 127.0.0.1:8000
	}

	# Hashed build assets: served by Caddy, cached forever.
	handle /_nuxt/* {
		root * /app/frontend/.output/public
		@asset file
		header @asset Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed zstd br gzip
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
